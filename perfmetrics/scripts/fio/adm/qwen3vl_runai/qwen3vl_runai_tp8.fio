; ADM fio job: Qwen3-VL-235B-A22B-Instruct, vLLM v0.16 + RunAI Model Streamer 0.15.6 (TP=8, defaults).
; Replays ONE 40 GB batch: 16 slices x 8 TP processes = 128 concurrent workers, each replaying its
; slice iolog generated by gen_runai_iologs.py. Run batch by batch in order via run_qwen3vl_runai_fio.sh.
;
; What this reproduces:
;   - buffered lseek + 2 MiB read() calls (ioengine=sync, direct=0), matching libstreamer.so
;   - 8 TP processes x 16 reader threads = 128 concurrent workers (16 slices x numjobs=8)
;   - shared kernel page cache (invalidate=0): all 8 processes read the same 16 slices, so GCSFuse sees each
;     byte once while each handle fetches ~1/8 of its range in forward jumps -> reproduces GCSFuse's per-handle
;     Random classification and ~5.7x GCS read amplification
;   - one fd (= one GCSFuse file handle) per worker per file, crossing file boundaries mid-slice as RunAI does
;   - batch barrier every 40 GB: one fio invocation per batch (12 batches = 471.34 GB)
;
; Works with STOCK fio >= 3.36 (no patch needed: ioengine=sync does not hit the mmap iolog bug).
; Model file paths in the iologs must not contain whitespace.

[global]
ioengine=sync
direct=0
; never drop the page cache per job: the 8 TP processes share it like vLLM workers
invalidate=0
; RunAI issues no fadvise: let kernel read_ahead_kb govern the FUSE request size (4-128 KiB at default 128 KiB)
fadvise_hint=0
iodepth=1
replay_no_stall=1
allow_file_create=0
; 8 TP processes walking the same slice concurrently
numjobs=8
group_reporting=1

[slice00]
read_iolog=${BATCH_DIR}/slice_00.iolog
[slice01]
read_iolog=${BATCH_DIR}/slice_01.iolog
[slice02]
read_iolog=${BATCH_DIR}/slice_02.iolog
[slice03]
read_iolog=${BATCH_DIR}/slice_03.iolog
[slice04]
read_iolog=${BATCH_DIR}/slice_04.iolog
[slice05]
read_iolog=${BATCH_DIR}/slice_05.iolog
[slice06]
read_iolog=${BATCH_DIR}/slice_06.iolog
[slice07]
read_iolog=${BATCH_DIR}/slice_07.iolog
[slice08]
read_iolog=${BATCH_DIR}/slice_08.iolog
[slice09]
read_iolog=${BATCH_DIR}/slice_09.iolog
[slice10]
read_iolog=${BATCH_DIR}/slice_10.iolog
[slice11]
read_iolog=${BATCH_DIR}/slice_11.iolog
[slice12]
read_iolog=${BATCH_DIR}/slice_12.iolog
[slice13]
read_iolog=${BATCH_DIR}/slice_13.iolog
[slice14]
read_iolog=${BATCH_DIR}/slice_14.iolog
[slice15]
read_iolog=${BATCH_DIR}/slice_15.iolog
