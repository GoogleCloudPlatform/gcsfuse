; ADM fio job v3: Qwen3-VL-235B-A22B-Instruct, vanilla vLLM v0.16, TP=8, safetensors lazy load (mmap).
; Replays ONE model file: 8 jobs = 8 TP ranks, each replaying its own iolog generated by
; gen_vllm_iologs.py (exact per-rank page touches in vLLM's copy order). Run it once per file, in file order,
; via run_qwen3vl_fio.sh.
;
; What this reproduces (see README.md for details and known gaps):
;   - page-fault reads (ioengine=mmap: memcpy from a MAP_SHARED mapping of the whole file), so the kernel
;     applies the same read-around and the 8 ranks share one page cache, as vLLM workers do
;   - one fd (= one GCSFuse file handle) per rank per file, open for the whole file
;   - each rank's exact pages and order: down_proj column sweep (first pages of a slice's rows, then second
;     pages), gate_up w1 for all experts then w3, rank 7 needing 2 of every 3 gate_up pages, vision tower
;     TP-sharded, attention shards, replicated norms/router
;   - no barriers between tensors: each rank walks the file on its own
;
; REQUIRES fio built with fio-mmap-iolog.patch (fio 3.36 tested). Files added by read_iolog skip fio's file sizing,
; so stock fio's mmap engine maps 0 bytes and fails with EINVAL; the patch sizes the mapping from the fd.
; (v2's fio-mmap-offset.patch is not needed: with an iolog the job's file_offset is 0.)
; iolog file paths must not contain whitespace.

[global]
ioengine=mmap
direct=0
; ranks share the page cache like vLLM workers: never drop it per job
invalidate=0
; vLLM issues no madvise/fadvise: keep the kernel's default fault read-around
fadvise_hint=0
; one faulting thread per rank (vLLM sets torch threads = 1); the mmap engine is synchronous anyway
iodepth=1
; replay as fast as possible, in order, ignoring the (absent) timestamps
replay_no_stall=1
allow_file_create=0
group_reporting=0

[rank0]
read_iolog=${IOLOG_DIR}/rank0.iolog
[rank1]
read_iolog=${IOLOG_DIR}/rank1.iolog
[rank2]
read_iolog=${IOLOG_DIR}/rank2.iolog
[rank3]
read_iolog=${IOLOG_DIR}/rank3.iolog
[rank4]
read_iolog=${IOLOG_DIR}/rank4.iolog
[rank5]
read_iolog=${IOLOG_DIR}/rank5.iolog
[rank6]
read_iolog=${IOLOG_DIR}/rank6.iolog
[rank7]
read_iolog=${IOLOG_DIR}/rank7.iolog
