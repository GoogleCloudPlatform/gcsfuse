[global]
ioengine=libaio
fadvise_hint=0
fallocate=none
invalidate=1
thread=1
openfiles=1
group_reporting=1
create_serialize=0
allrandrepeat=0
file_service_type=random
rw=read
iodepth=1
direct=0             # Set to 0 to enable page caching
filename_format=$jobname.$jobnum.$filenum.size-${FILE_SIZE}

[seq_read]
directory=/home/cpranjal_google_com/mnt/cpranjal-c4-std-192-us-west4a/write/10g/
bs=1m                # 1 MB blocks to trigger seek detector and MRD path
size=10g             # File size
numjobs=48           # Run with 1 thread (single stream) or 48 threads (concurrent streams)
nrfiles=1

