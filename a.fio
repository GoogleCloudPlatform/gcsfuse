[global]
ioengine=libaio
fadvise_hint=0
fallocate=none
invalidate=1
thread=1
openfiles=1
group_reporting=1
create_serialize=0
allrandrepeat=0
file_service_type=random
rw=read
iodepth=1
direct=0
filename_format=$jobname.$jobnum.$filenum.size-${FILE_SIZE}

[seq_read]
directory=/home/cpranjal_google_com/mnt/cpranjal-c4-std-192-us-west4a/write/10g
bs=1m
size=10g
numjobs=48
nrfiles=1
