[global]
exitall=1
allrandrepeat=0
create_serialize=0
direct=1
fadvise_hint=0
file_service_type=random
group_reporting=1
iodepth=1
ioengine=libaio
invalidate=1
numjobs=${NUMJOBS}
openfiles=1
rw=${READ_TYPE}
thread=1
filename_format=read/${FILE_SIZE}/${NR_FILES}/experiment.$jobnum.$filenum
disk_util=0

[read]
stonewall
directory=${DIR}
bs=${BLOCK_SIZE}
filesize=${FILE_SIZE}
nrfiles=${NR_FILES}
